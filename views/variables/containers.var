containers:
  header: "Containers:"
  paths:
    - paths:
        - "spec#initContainers"
        - "spec#containers"
      pathtype: "items"
      subpaths:
        - "name"
        - subpath: "image"
          regex: ["^.+/[^:^/]+:(.+?)@.*", "^.+/[^:^/]+:(.+)"]
      type: "raw"
  formatter: "list"
  formatting:
    field_colors:
      - type: "generic"
      - type: "version"
    field_separators:
      - type: "version"
    field_formatters:
      - ""
      - "version"
