---
kind: "PodDisruptionBudget"
api_family: "policy"
default_command: "poddisruptionbudgets"
command:
  - "pdb"
listview:
  name: "Pod Disruption Budgets"
  group: "Policy"
  field_indexes:
    Wide:
      fields: ["namespace", "name", "controller", "min_available",
               "max_unavailable", "allowed_disruptions", "age"]
      sortcolumn: "namespace"
    Normal:
      fields: ["namespace", "name", "min_available",
               "max_unavailable", "allowed_disruptions", "age"]
      sortcolumn: "namespace"
  fields:
    allowed_disruptions:
      header: "Allowed Disruptions:"
      paths:
        - path: "status#disruptionsAllowed"
          type: "int"
          default: 0
      formatter: "numerical"
      align: "right"
    {%- for line in field_controller.split("\n") %}
    {{ line }}
    {%- endfor %}
    max_unavailable:
      header: "Max Unavailable:"
      paths:
        - path: "spec#maxUnavailable"
          type: "int"
          default: "<unset>"
      formatter: "numerical"
      align: "right"
    min_available:
      header: "Min Available:"
      paths:
        - path: "spec#minAvailable"
          type: "int"
          default: "<unset>"
      formatter: "numerical"
      align: "right"
infoview:
  name: "Pod Disruption Budget Info"
  infopad:
    row_indexes:
      Normal:
        fields: ["controller", "min_available", "max_unavailable",
                 "selector", "status_header",
                 "expected_pods", "current_healthy", "desired_healthy",
                 "unhealthy_pod_eviction_policy", "disruptions_allowed"]
    rows:
      {%- for line in row_controller.split("\n") %}
      {{ line }}
      {%- endfor %}
      current_healthy:
        header: [["  Current Healthy:", ["main", "infoheader"]]]
        path: "status#currentHealthy"
        type: "int"
        formatter: "numerical"
      desired_healthy:
        header: [["  Desired Healthy:", ["main", "infoheader"]]]
        path: "status#desiredHealthy"
        type: "int"
        formatter: "numerical"
      disruptions_allowed:
        header: [["  Disruptions Allowed:", ["main", "infoheader"]]]
        path: "status#disruptionsAllowed"
        type: "int"
        formatter: "numerical"
      expected_pods:
        header: [["  Expected Pods:", ["main", "infoheader"]]]
        path: "status#expectedPods"
        type: "int"
        formatter: "numerical"
      max_unavailable:
        header: [["Max Unavailable:", ["main", "infoheader"]]]
        path: "spec#maxUnavailable"
        default: "<unset>"
        type: "int"
        formatter: "numerical"
      min_available:
        header: [["Min Available:", ["main", "infoheader"]]]
        path: "spec#minAvailable"
        default: "<unset>"
        type: "int"
        formatter: "numerical"
      selector:
        header: [["Selec", ["main", "infoheader"]],
                 ["t", ["main", "infoheader_shortcut"]],
                 ["or:", ["main", "infoheader"]]]
        paths:
          - path: "spec#selector"
            pathtype: "obj"
            default: "<none>"
        formatter: "selector"
      status_header:
        header: [["Status:", ["main", "infoheader"]]]
      unhealthy_pod_eviction_policy:
        header: [["  Unhealthy Pod Eviction Policy:", ["main", "infoheader"]]]
        path: "status#unhealthyPodEvictionPolicy"
        type: "str"
        default: "<unset>"
  shortcuts:
    {%- for line in shortcut_controller.split("\n") %}
    {{ line }}
    {%- endfor %}
    "Selector":
      key: "t"
      read_only: true
      helptext: "Show selector"
      widget: "windowwidget"
      widget_args:
        title: "Selector:"
        itemgetter: "get_selector_list"
        itemgetter_args:
          path: "spec#selector"
