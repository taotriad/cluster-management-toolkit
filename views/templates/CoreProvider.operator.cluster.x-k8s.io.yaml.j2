---
kind: "CoreProvider"
api_family: "operator.cluster.x-k8s.io"
default_command: "coreproviders"
command:
  - "coreprovs"
  - "coreprov"
listview:
  name: "Core Providers"
  group: "Cluster Configuration"
  field_indexes:
    Normal:
      fields: ["namespace", "name", "installed_version",
               "condition_ready", "age"]
      sortcolumn: "namespace"
  fields:
    {%- for line in field_condition_ready.split("\n") %}
    {{ line }}
    {%- endfor %}
    installed_version:
      header: "Installed Version:"
      path: "status#installedVersion"
      type: "str"
      formatter: "version"
infoview:
  name: "Core Provider Info"
  infopad:
    row_indexes:
      Normal:
        fields: ["fetch_config_selector", "installed_version", "contract",
                 "condition_ready"]
    rows:
      {%- for line in row_condition_ready.split("\n") %}
      {{ line }}
      {%- endfor %}
      contract:
        header: [["Contract:", ["main", "infoheader"]]]
        path: "status#contract"
        type: "str"
        formatter: "version"
      fetch_config_selector:
        header: [["Fetch Config Selec", ["main", "infoheader"]],
                 ["t", ["main", "infoheader_shortcut"]],
                 ["or:", ["main", "infoheader"]]]
        paths:
          - path: "spec#fetchConfig#selector"
            pathtype: "obj"
            default: "<none>"
        formatter: "selector"
      installed_version:
        header: [["Installed Version:", ["main", "infoheader"]]]
        path: "status#installedVersion"
        type: "str"
        formatter: "version"
  shortcuts:
    "Fetch Config Selector":
      key: "t"
      read_only: true
      helptext: "Show fetch config selector"
      widget: "windowwidget"
      widget_args:
        title: "Fetch Config Selector:"
        itemgetter: "get_selector_list"
        itemgetter_args:
          path: "spec#fetchConfig#selector"
    "Podsets":
      key: "d"
      modifier: "shift"
      read_only: true
      helptext: "Show deployment"
      action: "call"
      action_call: "view_yaml"
      action_args:
        title: "Deployment"
        _pass_obj: true
        path: "spec#deployment"
