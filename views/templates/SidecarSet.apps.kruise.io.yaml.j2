---
kind: "SidecarSet"
api_family: "apps.kruise.io"
default_command: "sidecarsets"
listview:
  name: "Side Car Sets"
  group: "Kruise"
  field_indexes:
    Normal:
      fields: ["spec_namespace", "name", "age"]
  fields:
    spec_namespace:
      header: "Namespace:"
      path: "spec#namespace"
      default: "<global>"
      type: "str"
      formatting:
        field_colors:
          - type: "namespace"
infoview:
  name: "Side Car Set Info"
  infopad:
    row_indexes:
      Normal:
        fields:
          - "spec_namespace"
          - "selector"
          - "update_strategy"
          - "status_header"
          - "status_collisions"
          - "status_matched_pods"
          - "status_ready_pods"
          - "status_updated_pods"
          - "status_observed_generation"
    rows:
      {%- for line in row_selector.split("\n") %}
      {{ line }}
      {%- endfor %}
      spec_namespace:
        header: [["Namespace:", ["main", "infoheader"]]]
        path: "spec#namespace"
        default: "<global>"
        type: "str"
        formatting:
          field_colors:
            - type: "namespace"
      status_header:
        header: [["Status:", ["main", "infoheader"]]]
      status_collisions:
        header: [["  Collisions:", ["main", "infoheader"]]]
        path: "status#collisionCount"
        type: "int"
        formatter: "numerical"
      status_matched_pods:
        header: [["  Matched Pods:", ["main", "infoheader"]]]
        path: "status#matchedPods"
        type: "int"
        formatter: "numerical"
      status_observed_generation:
        header: [["  Observed Generation:", ["main", "infoheader"]]]
        path: "status#observedGeneration"
        type: "int"
        formatter: "numerical"
      status_ready_pods:
        header: [["  Ready Pods:", ["main", "infoheader"]]]
        path: "status#readyPods"
        type: "int"
        formatter: "numerical"
      status_updated_pods:
        header: [["  Updated Pods:", ["main", "infoheader"]]]
        path: "status#updatedPods"
        type: "int"
        formatter: "numerical"
      update_strategy:
        header: [["Update Strategy:", ["main", "infoheader"]]]
        paths:
          - path: [["spec#updateStrategy#type"],
                   " (", "Partition: ",
                   ["spec#updateStrategy#rollingUpdate#partition"],
                   "Max Unavailable: ",
                   ["spec#updateStrategy#maxUnavailable"], ")"]
            pathtype: "tuple"
            when:
              - key: "spec#updateStrategy#type"
                eq: "RollingUpdate"
            default: ["RollingUpdate", "", "", "1", ""]
          - path: [["spec#strategy#type"]]
            pathtype: "tuple"
            when:
              - key: "spec#updateStrategy#type"
                eq: "NotUpdate"
        formatter: "list"
        formatting:
          field_colors:
            - type: "generic"
            - type: "generic"
            - context: "main"
              type: "infoheader"
            - type: "numerical"
            - context: "main"
              type: "infoheader"
            - type: "numerical"
            - type: "generic"
          field_separators:
            - type: "no_pad"
            - type: "no_pad"
            - type: "no_pad"
            - type: "list"
            - type: "no_pad"
  {%- for line in listpad_pod_spec_selector_matchlabels.split("\n") %}
  {{ line }}
  {%- endfor %}
  shortcuts:
    {%- for line in shortcut_selector.split("\n") %}
    {{ line }}
    {%- endfor %}
    "View Sidecar Containers":
      key: "c"
      read_only: true
      helptext: "Show sidecar container specs"
      action: "call"
      action_call: "view_yaml"
      action_args:
        title: "Sidecar container specs"
        _pass_obj: true
        path: "spec#containers"
        include_root: true
    "View Sidecar InitContainers":
      key: "i"
      read_only: true
      helptext: "Show sidecar init-container specs"
      action: "call"
      action_call: "view_yaml"
      action_args:
        title: "Sidecar init-container specs"
        _pass_obj: true
        path: "spec#initContainers"
        include_root: true
