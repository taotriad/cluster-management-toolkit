---
kind: "ModuleDocumentation"
api_family: "deckhouse.io"
default_command: "moduledocumentations"
command:
  - "moddocs"
  - "moddoc"
listview:
  name: "Module Documentations"
  group: "Deckhouse"
  field_indexes:
    Normal:
      fields: ["name", "controller", "path", "version", "age"]
  fields:
    {%- for line in field_controller.split("\n") %}
    {{ line }}
    {%- endfor %}
    path:
      header: "Path:"
      path: "spec#path"
      default: "<unset>"
      type: "str"
      formatting:
        field_colors:
          - type: "path"
    version:
      header: "Version:"
      path: "spec#version"
      default: "<unset>"
      type: "str"
      formatter: "version"
infoview:
  name: "Module Documentation Info"
  infopad:
    row_indexes:
      Normal:
        fields: ["controller", "path", "version"]
    rows:
      {%- for line in row_controller.split("\n") %}
      {{ line }}
      {%- endfor %}
      path:
        header: [["Path:", ["main", "infoheader"]]]
        path: "spec#path"
        default: "<unset>"
        type: "str"
        formatting:
          field_colors:
            - type: "path"
      version:
        header: [["Version:", ["main", "infoheader"]]]
        path: "spec#version"
        default: "<unset>"
        type: "str"
        formatter: "version"
  shortcuts:
    {%- for line in shortcut_controller.split("\n") %}
    {{ line }}
    {%- endfor %}
