---
kind: "TrainJob"
api_family: "trainer.kubeflow.org"
default_command: "trainjobs"
listview:
  name: "Train Jobs"
  group: "Kubeflow"
  field_indexes:
    Wide:
      fields: ["namespace", "name", "controller",
               "managed_by", "suspended", "age"]
      sortcolumn: "namespace"
    Normal:
      fields: ["namespace", "name", "suspended", "age"]
      sortcolumn: "namespace"
  fields:
    {%- for line in field_controller.split("\n") %}
    {{ line }}
    {%- endfor %}
    managed_by:
      header: "Managed By:"
      path: "spec#managedBy"
      default: "<unset>"
      type: "str"
    suspended:
      header: "Suspended:"
      path: "spec#suspend"
      default: "<unset>"
      type: "bool"
      formatter: "value_mapper"
      formatting:
        mapping:
          mappings:
            "False":
              field_colors:
                - context: "main"
                  type: "status_ok"
            "True":
              field_colors:
                - context: "main"
                  type: "status_pending"
  actions:
    actionlist:
      "Delete resource":
        description: "Delete resource"
        category: "Resource Level"
        confirm: true
        actionfunc: "delete_resource"
      "Resume resource":
        # Requires Kubernetes 1.22+
        description: "Resume resource"
        category: "Resource Level"
        actionfunc: "patch_resource"
        extravars:
          action_str: "Resuming"
          args:
            patch:
              spec:
                suspend: false
            strategic_merge: true
      "Suspend resource":
        # Requires Kubernetes 1.22+
        description: "Suspend resource"
        category: "Resource Level"
        actionfunc: "patch_resource"
        extravars:
          action_str: "Suspending"
          args:
            patch:
              spec:
                suspend: true
            strategic_merge: true
infoview:
  name: "Train Job Info"
  infopad:
    row_indexes:
      Normal:
        fields: ["controller", "managed_by", "runtime", "trainer_header",
                 "trainer_image",
                 "trainer_nodes", "trainer_processes_per_node",
                 "suspended"]
    rows:
      {%- for line in row_controller.split("\n") %}
      {{ line }}
      {%- endfor %}
      managed_by:
        header: [["Managed By:", ["main", "infoheader"]]]
        path: "spec#managedBy"
        default: "<unset>"
        type: "str"
      runtime:
        header: [["Run", ["main", "infoheader"]],
                 ["t", ["main", "infoheader_shortcut"]],
                 ["ime:", ["main", "infoheader"]]]
        paths:
          - path: [["spec#runtimeRef#kind"],
                   ["spec#runtimeRef#apiGroup"],
                   ["spec#runtimeRef#name"]]
            pathtype: "tuple"
            type: ["kind", "api_group", "name"]
            default: ["<none>"]
        formatter: "list"
        formatting:
          field_colors:
            - type: "kind"
            - type: "api_group"
            - type: "generic"
          field_separators:
            - type: "kind_api_group"
            - type: "kind"
      suspended:
        header: [["Suspended:", ["main", "infoheader"]]]
        path: "spec#suspend"
        default: "<unset>"
        type: "bool"
        formatter: "value_mapper"
        formatting:
          mapping:
            mappings:
              "False":
                field_colors:
                  - context: "main"
                    type: "status_ok"
              "True":
                field_colors:
                  - context: "main"
                    type: "status_pending"
      trainer_header:
        header: [["Trainer:", ["main", "infoheader"]]]
      trainer_image:
        header: [["  Image:", ["main", "infoheader"]]]
        paths:
          - path: "spec#trainer#image"
            pathtype: "regex"
            regex: "^([^:]+):(.*)"
            default: ["<none>"]
        formatter: "list"
        formatting:
          field_colors:
            - type: "generic"
            - type: "version"
          field_separators:
            - type: "version"
      trainer_nodes:
        header: [["  Nodes:", ["main", "infoheader"]]]
        path: "spec#trainer#numNodes"
        default: "<unset>"
        type: "int"
        formatter: "numerical"
      trainer_processes_per_node:
        header: [["  Processes per Node:", ["main", "infoheader"]]]
        path: "spec#trainer#numProcPerNode"
        default: "<unset>"
        type: "int"
        formatter: "numerical"
  logpad:
    title: "Command:"
    infogetter: "logpad_formatted"
    infogetter_args:
      formatter: "format_yaml"
      path: "spec#trainer#command"
      reparent: "command"
    timestamps: false
  shortcuts:
    {%- for line in shortcut_controller.split("\n") %}
    {{ line }}
    {%- endfor %}
    "Open Runtime":
      key: "t"
      read_only: true
      helptext: "Open info page for runtime"
      action: "call"
      action_call: "resourceinfodispatch_with_lookup"
      action_args:
        _pass_obj: true
        namespace_path: "metadata#namespace"
        name_path: "spec#runtimeRef#name"
        kind_path: "spec#runtimeRef#kind"
        api_family_path: "spec#runtimeRef#apiGroup"
    "Show Job Status":
      key: "j"
      modifier: "shift"
      read_only: true
      helptext: "Show job status"
      widget: "windowwidget"
      widget_args:
        title: "Job Status:"
        headers: ["Name:", "Succeeded:", "Failed:", "Active:",
                  "Ready:", "Suspended:"]
        itemgetter: "get_list_fields"
        itemgetter_args:
          path: "status#jobsStatus"
          fields:
            - "name"
            - "succeeded"
            - "failed"
            - "active"
            - "ready"
            - "suspended"
        # This isn't supported for now
        sortcolumn: "name"
    "List Runtime Patches":
      key: "p"
      modifier: "shift"
      read_only: true
      helptext: "List runtime patches"
      widget: "windowwidget"
      widget_args:
        title: "Runtime Patches:"
        headers: ["Index:", "Manager:", "Time:"]
        selectable: true
        itemgetter: "get_list_fields"
        itemgetter_args:
          path: "spec#runtimePatches"
          fields:
            - value: "index"
              index_template: "<<<index>>>"
            - "manager"
            - "time"
          pass_ref: true
        # Not supported for now
        sortcolumn: "index"
      action: "call"
      action_call: "resourceinfodispatch_from_selection"
      action_args:
        kind: "__RuntimePatch"
        api_family: "trainer.kubeflow.org"
