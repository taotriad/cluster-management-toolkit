---
# WARNING: Do NOT edit this file directly; it is generated from the template
# views/templates/VirtualMachineTemplate.template.kubevirt.io.yaml.j2
# edit that file instead.
#
kind: "VirtualMachinePool"
api_family: "pool.kubevirt.io"
default_command: "virtualmachinepools"
command:
  - "virtmchpools"
  - "virtmchpool"
  - "kvvmpools"
  - "kvvmpool"
listview:
  name: "Virtual Machine Pools"
  group: "Virtualization"
  field_indexes:
    Normal:
      fields: ["namespace", "name", "age"]
      sortcolumn: "namespace"
infoview:
  name: "Virtual Machine Pool Info"
  infopad:
    row_indexes:
      Normal:
        fields: ["selector", "replicas"]
    rows:
      replicas:
        header: [["Replicas:", ["main", "infoheader"]]]
        paths:
          - path: [["spec#replicas"], " Desired",
                   ["status#replicas"], " Current",
                   ["status#readyReplicas"], " Ready"]
            pathtype: "tuple"
            default: [0, "", 0, "", 0, ""]
        formatter: "list"
        formatting:
          field_colors:
            - type: "numerical"
            - type: "generic"
            - type: "numerical"
            - type: "generic"
            - type: "numerical"
            - type: "generic"
          field_separators:
            - type: "no_pad"
            - type: "fraction_spaced"
            - type: "no_pad"
            - type: "fraction_spaced"
            - type: "no_pad"
      selector:
        header: [["Selec", ["main", "infoheader"]],
                 ["t", ["main", "infoheader_shortcut"]],
                 ["or:", ["main", "infoheader"]]]
        paths:
          - path: "spec#selector"
            pathtype: "obj"
            default: "<none>"
        formatter: "selector"
  listpad:
    listgetter: "generic_listgetter"
    listgetter_args:
      _kind: "VirtualMachine"
      _api_family: "kubevirt.io"
      _label_selector_path: "spec#selector#matchLabels"
      _none_on_empty_selector: true
    infogetter: "generic_infogetter"
    on_activation:
      call: "resourceinfodispatch"
      kind: "VirtualMachine"
      api_family: "kubevirt.io"
    field_indexes:
      Normal:
        fields: ["namespace", "name", "vm_created",
                 "status", "condition_ready", "age"]
        sortcolumn: "status"
    fields:
      {%- for line in field_condition_ready.split("\n") %}
      {{ line }}
      {%- endfor %}
      status:
        header: "Status:"
        path: "status#printableStatus"
        default: "<unset>"
        type: "str"
        formatter: "value_mapper"
        formatting:
          mapping:
            mappings:
              CrashLoopBackOff:
                field_colors:
                  - context: "main"
                    type: "status_not_ok"
              ErrorUnschedulable:
                field_colors:
                  - context: "main"
                    type: "status_not_ok"
              Running:
                field_colors:
                  - context: "main"
                    type: "status_ok"
              Starting:
                field_colors:
                  - context: "main"
                    type: "status_pending"
              Stopped:
                field_colors:
                  - context: "main"
                    type: "status_done"
              Stopping:
                field_colors:
                  - context: "main"
                    type: "status_pending"
              __default:
                field_colors:
                  - context: "types"
                    type: "generic"
      vm_created:
        header: "VM Created:"
        path: "status#created"
        default: "<unset>"
        type: "str"
  shortcuts:
    "Selector":
      key: "t"
      read_only: true
      helptext: "Show selector"
      widget: "windowwidget"
      widget_args:
        title: "Selector:"
        itemgetter: "get_selector_list"
        itemgetter_args:
          path: "spec#selector"
    "Virtual Machine template":
      key: "t"
      modifier: "shift"
      read_only: true
      helptext: "Show Virtual Machine template"
      action: "call"
      action_call: "view_yaml"
      action_args:
        title: "Virtual Machine template"
        _pass_obj: true
        path: "spec#virtualMachineTemplate"
