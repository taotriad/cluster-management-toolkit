---
kind: "MachineSet"
api_family: "machine.openshift.io"
default_command: "machinesets.machine.openshift.io"
command:
  - "os-ms"
listview:
  name: "Machine Sets"
  group: "OpenShift"
  field_indexes:
    Wide:
      fields: ["namespace", "name", "desired", "observed", "ready",
               "available", "fully_labelled", "age"]
      sortcolumn: "namespace"
    Normal:
      fields: ["namespace", "name", "desired", "observed", "ready",
               "available", "age"]
      sortcolumn: "namespace"
  fields:
    available:
      header: "Available:"
      path: "status#availableReplicas"
      default: 0
      type: "int"
      formatter: "numerical"
      align: "right"
    desired:
      header: "Desired:"
      path: "spec#replicas"
      type: "int"
      formatter: "numerical"
      align: "right"
    fully_labelled:
      header: "Fully Labelled:"
      path: "spec#replicas"
      type: "int"
      formatter: "numerical"
      align: "right"
    observed:
      header: "Observed:"
      path: "status#replicas"
      type: "int"
      formatter: "numerical"
      align: "right"
    ready:
      header: "Ready:"
      path: "status#readyReplicas"
      default: 0
      type: "int"
      formatter: "numerical"
      align: "right"
infoview:
  name: "Machine Set Info"
  infopad:
    row_indexes:
      Normal:
        fields: ["selector",
                 "delete_policy", "minimum_ready_seconds",
                 "replicas_header", "desired", "observed", "ready",
                 "available", "fully_labelled"]
    rows:
      available:
        header: [["  Available:", ["main", "infoheader"]]]
        path: "status#availableReplicas"
        default: 0
        type: "int"
        formatter: "numerical"
      delete_policy:
        header: [["Delete Policy:", ["main", "infoheader"]]]
        path: "spec#deletePolicy"
        default: "Random"
        type: "str"
      desired:
        header: [["  Desired:", ["main", "infoheader"]]]
        path: "spec#replicas"
        type: "int"
        formatter: "numerical"
      fully_labelled:
        header: [["  Fully Labelled:", ["main", "infoheader"]]]
        path: "spec#replicas"
        type: "int"
        formatter: "numerical"
      minimum_ready_seconds:
        header: [["Minimum Ready:", ["main", "infoheader"]]]
        path: "spec#minReadySeconds"
        default: 0
        type: "int"
        formatter: "numerical"
        formatting:
          unit: "s"
      observed:
        header: [["  Observed:", ["main", "infoheader"]]]
        path: "status#replicas"
        type: "int"
        formatter: "numerical"
      ready:
        header: [["  Ready:", ["main", "infoheader"]]]
        path: "status#readyReplicas"
        default: 0
        type: "int"
        formatter: "numerical"
      replicas_header:
        header: [["Replicas:", ["main", "infoheader"]]]
      {%- for line in row_selector.split("\n") %}
      {{ line }}
      {%- endfor %}
  shortcuts:
    {%- for line in shortcut_selector.split("\n") %}
    {{ line }}
    {%- endfor %}
