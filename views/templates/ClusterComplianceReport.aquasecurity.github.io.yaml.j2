---
kind: "ClusterComplianceReport"
api_family: "aquasecurity.github.io"
default_command: "clustercompliancereports"
command:
  - "clustercompliances"
  - "clustercompliance"
  - "clrcompliances"
  - "clrcompliance"
listview:
  name: "Cluster Compliance Reports"
  group: "Security"
  field_indexes:
    Normal:
      fields: ["name", "title", "version", "severity_fail",
               "severity_pass", "age", "description"]
  fields:
    description:
      header: "Description:"
      path: "spec#compliance#description"
      default: "<unset>"
      type: "str"
    severity_fail:
      header: "Fail:"
      path: "status#summary#failCount"
      default: 0
      type: "raw"
      formatter: "value_mapper"
      formatting:
        mapping:
          ranges:
            - min: 0
              max: 1
              field_colors:
                - context: "types"
                  type: "watermark_low"
            - default: true
              field_colors:
                - context: "types"
                  type: "watermark_high"
      align: "right"
    severity_pass:
      header: "Pass:"
      path: "status#summary#passCount"
      default: 0
      type: "int"
      formatter: "numerical"
      align: "right"
    title:
      header: "Title:"
      path: "spec#compliance#title"
      default: "<unset>"
      type: "str"
    version:
      header: "Version:"
      path: "spec#compliance#version"
      default: "<unset>"
      type: "str"
      formatter: "version"
infoview:
  name: "Cluster Compliance Report Info"
  infopad:
    row_indexes:
      Normal:
        fields: ["controller", "title", "version", "description",
                 "severity_header", "severity_pass",
                 "severity_fail", "cron_schedule"]
    rows:
      {%- for line in row_controller.split("\n") %}
      {{ line }}
      {%- endfor %}
      cron_schedule:
        header: [["Cron Schedule:", ["main", "infoheader"]]]
        path: "spec#cron"
        type: "str"
      description:
        header: [["D", ["main", "infoheader_shortcut"]],
                 ["escription:", ["main", "infoheader"]]]
        path: "spec#compliance#description"
        type: "str"
      severity_pass:
        header: [["  Pass:", ["main", "infoheader"]]]
        path: "status#summary#passCount"
        type: "int"
        formatter: "numerical"
      severity_header:
        header: [["Severity:", ["main", "infoheader"]]]
      severity_fail:
        header: [["  Fail:", ["main", "infoheader"]]]
        path: "status#summary#failCount"
        type: "raw"
        formatter: "value_mapper"
        formatting:
          mapping:
            ranges:
              - min: 0
                max: 1
                field_colors:
                  - context: "types"
                    type: "watermark_low"
              - default: true
                field_colors:
                  - context: "types"
                    type: "watermark_high"
      title:
        header: [["Title:", ["main", "infoheader"]]]
        path: "spec#compliance#title"
        type: "str"
      version:
        header: [["Version:", ["main", "infoheader"]]]
        path: "spec#compliance#version"
        type: "str"
        formatter: "version"
  listpad:
    on_activation:
      call: "resourceinfodispatch"
      kind: "__ClusterComplianceReportData"
      api_family: "aquasecurity.github.io"
    listgetter: "listgetter_path"
    listgetter_args:
      join_key: "id"
      paths:
        - path: "spec#compliance#controls"
          key_name: "__type"
          key_value: "Basic"
        - path: "status#summaryReport#controlCheck"
          key_name: "__type"
          key_value: "Basic"
    infogetter: "generic_infogetter"
    field_indexes:
      Wide:
        fields: ["id", "name", "severity", "total_fail", "description"]
        sortcolumn: "severity"
      Normal:
        fields: ["id", "name", "severity", "total_fail"]
        sortcolumn: "severity"
    fields:
      description:
        header: "Description:"
        path: "description"
        type: "str"
      id:
        header: "ID:"
        path: "id"
        type: "str"
      name:
        header: "Name:"
        path: "name"
        type: "str"
      severity:
        header: "Severity:"
        paths:
          - path: "severity"
            pathtype: "remap"
            substitutions:
              "CRITICAL": "Critical"
              "HIGH": "High"
              "LOW": "Low"
              "MEDIUM": "Medium"
              "UNKNOWN": "Unknown"
            when:
              - key: "totalFail"
                gt: 0
        default: "Unaffected"
        type: "str"
        formatter: "value_mapper"
        formatting:
          mapping:
            mappings:
              "Critical":
                index: 0
                field_colors:
                  - context: "main"
                    type: "severity_critical"
              "High":
                index: 1
                field_colors:
                  - context: "main"
                    type: "severity_high"
              "Low":
                index: 4
                field_colors:
                  - context: "main"
                    type: "status_admin"
              "Medium":
                index: 2
                field_colors:
                  - context: "main"
                    type: "severity_medium"
              "Unaffected":
                index: 5
                field_colors:
                  - context: "main"
                    type: "status_ok"
              "Unknown":
                index: 3
                field_colors:
                  - context: "main"
                    type: "severity_medium"
      total_fail:
        header: "Total Failed:"
        path: "totalFail"
        type: "int"
        default: "Manual check needed"
        formatter: "numerical"
        align: "right"
  shortcuts:
    {%- for line in shortcut_controller.split("\n") %}
    {{ line }}
    {%- endfor %}
    "Show Description":
      key: "d"
      modifier: "shift"
      read_only: true
      helptext: "Show description"
      widget: "windowwidget"
      widget_args:
        title: "Description"
        # If the data is one single line we reformat it.
        wrap_lines: true
        itemgetter: "get_strings_from_string"
        itemgetter_args:
          path: "spec#compliance#description"
