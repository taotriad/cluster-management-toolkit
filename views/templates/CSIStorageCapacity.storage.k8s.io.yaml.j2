---
kind: "CSIStorageCapacity"
api_family: "storage.k8s.io"
default_command: "csistoragecapacities"
command:
  - "csistoragecaps"
  - "csistoragecap"
listview:
  name: "CSI Storage Capacities"
  group: "Storage & Backups"
  field_indexes:
    Normal:
      fields: ["namespace", "name", "controller", "storage_class_name", "age"]
  fields:
    {%- for line in field_controller.split("\n") %}
    {{ line }}
    {%- endfor %}
    storage_class_name:
      header: "Storage Class Name:"
      path: "storageClassName"
      type: "str"
infoview:
  name: "CSI Storage Capacity Info"
  infopad:
    row_indexes:
      Normal:
        fields: ["controller", "storage_class",
                 "node_topology_selector", "capacity"]
    rows:
      capacity:
        header: [["Capacity:", ["main", "infoheader"]]]
        path: "capacity"
        type: "str"
        formatter: "numerical"
      {%- for line in row_controller.split("\n") %}
      {{ line }}
      {%- endfor %}
      node_topology_selector:
        header: [["Node Topology Selec", ["main", "infoheader"]],
                 ["t", ["main", "infoheader_shortcut"]],
                 ["or:", ["main", "infoheader"]]]
        paths:
          - path: "nodeTopology"
            pathtype: "obj"
            default: "<none>"
        formatter: "selector"
      storage_class:
        header: [["S", ["main", "infoheader_shortcut"]],
                 ["torage Class:", ["main", "infoheader"]]]
        path: "storageClassName"
        default: "<none>"
        type: "str"
  shortcuts:
    "Node Topology Selector":
      key: "t"
      read_only: true
      helptext: "Show Node topology selector"
      widget: "windowwidget"
      widget_args:
        title: "Node Topology Selector:"
        itemgetter: "get_selector_list"
        itemgetter_args:
          path: "nodeTopology"
    {%- for line in shortcut_controller.split("\n") %}
    {{ line }}
    {%- endfor %}
    "Open Storage Class":
      key: "s"
      modifier: "shift"
      read_only: true
      helptext: "Open info page for Storage Class"
      action: "call"
      action_call: "resourceinfodispatch_with_lookup"
      action_args:
        _pass_obj: true
        kind: "StorageClass"
        api_family: "storage.k8s.io"
        name_path: "storageClassName"
