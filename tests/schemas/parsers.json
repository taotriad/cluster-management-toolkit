{
    "description": "A list of parser rules for the log viewer",
    "type": "array",
    "$defs": {
        "error": {
            "description": "Configuration options related to errors",
            "type": "object",
            "properties": {
                "keys": {
                    "description": "A list of keys should be regarded as error fields",
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "tags": {
                    "description": "A dict of tags should be regarded as error tags",
                    "type": "object",
                    "patternProperties": {
                        "^[A-Z][A-Za-z0-9_]*[A-Za-z0-9]$": {
                            "type": "object",
                            "patternProperties": {
                                "^[A-Z][A-Za-z0-9_]*[A-Za-z0-9]$": {
                                    "$ref": "#/$defs/loglevel"
                                }
                            }
                        }
                    }
                }
            },
            "minItems": 1
        },
        "formatter_allowlist": {
            "enum": [
                "format_autodetect",
                "format_caddyfile",
                "format_cel",
                "format_crt",
                "format_css",
                "format_docker",
                "format_fluentbit",
                "format_haproxy",
                "format_html",
                "format_ini",
                "format_javascript",
                "format_key_value",
                "format_known_hosts",
                "format_mosquitto",
                "format_nginx",
                "format_none",
                "format_powershell",
                "format_promql",
                "format_python",
                "format_python_traceback",
                "format_rego",
                "format_toml",
                "format_xml",
                "format_yaml",
                "reformat_json",
                "render_markdown"
            ]
        },
        "message": {
            "description": "Configuration options related to messages",
            "type": "object",
            "properties": {
                "keys": {
                    "description": "A list of keys should be regarded as message fields",
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                }
            },
            "minItems": 1
        },
        "severity": {
            "description": "Configuration options related to severities",
            "type": "object",
            "properties": {
                "default": {
                    "$ref": "#/$defs/loglevel"
                },
                "highlight_reason": {
                    "description": "Should Event reason be highlighted?",
                    "type": "boolean"
                },
                "keys": {
                    "description": "A list of keys should be regarded as severity fields",
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "overrides": {
                    "$ref": "#/$defs/severity_overrides"
                }
            },
            "additionalProperties": false
        },
        "timestamp": {
            "description": "Configuration options related to timestmaps",
            "type": "object",
            "properties": {
                "keys": {
                    "description": "A list of keys should be regarded as timestamp fields",
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "minItems": 1
                },
                "reformat": {
                    "description": "Should timestamps be reformatted to ISO-8601?",
                    "type": "boolean"
                }
            },
            "additionalProperties": false
        },
        "facility": {
            "description": "Configuration options related to facilities",
            "type": "object",
            "properties": {
                "keys": {
                    "description": "A list of keys should be regarded as facility fields",
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "separators": {
                    "description": "Separators between facilities if multiple facilities are found",
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                }
            },
            "minItems": 1
        },
        "version": {
            "description": "Configuration options related to versions",
            "type": "object",
            "properties": {
                "keys": {
                    "description": "A list of keys should be regarded as version fields",
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                }
            },
            "minItems": 1
        },
        "severity_overrides": {
            "description": "A list of severity_overrides",
            "type": "array",
            "items": {
                "$ref": "#/$defs/severity_override"
            },
            "minItems": 1
        },
        "severity_override": {
            "description": "A severity override",
            "type": "object",
            "properties": {
                "matchtype": {
                    "enum": [
                        "contains",
                        "endswith",
                        "exact",
                        "regex",
                        "startswith"
                    ]
                },
                "matchkey": {
                    "type": "string"
                },
                "loglevel": {
                    "$ref": "#/$defs/loglevel"
                }
            },
            "required": [ "matchtype", "matchkey", "loglevel" ]
        },
        "loglevel": {
            "enum": [
                "emergency",
                "alert",
                "critical",
                "error",
                "warning",
                "notice",
                "info",
                "debug"
            ]
        },
        "match_rule": {
            "description": "A set of rules to match individual containers",
            "type": "object",
            "properties": {
                "pod_name": {
                    "$ref": "#/$defs/pod_name"
                },
                "container_name": {
                    "$ref": "#/$defs/container_name"
                },
                "container_type": {
                    "$ref": "#/$defs/container_type"
                },
                "image_name": {
                    "$ref": "#/$defs/image_name"
                },
                "image_regex": {
                    "$ref": "#/$defs/image_regex"
                }
            },
            "additionalProperties": false
        },
        "pod_name": {
            "description": "The prefix for a pod name",
            "type": "string"
        },
        "container_name": {
            "description": "The prefix for a container name",
            "type": "string"
        },
        "container_type": {
            "description": "The container type",
            "type": "string",
            "enum": [
                "Container",
                "InitContainer"
            ]
        },
        "image_name": {
            "description": "The prefix for the name of the container image",
            "type": "string"
        },
        "image_regex": {
            "description": "A regex pattern to match container image names against",
            "type": "string"
        }
    },
    "items": {
        "description": "A parser rule set",
        "type": "object",
        "properties": {
            "name": {
                "description": "The name of the rule set",
                "type": "string",
                "pattern": "^[A-Za-z0-9=_-]*[A-Za-z0-9]$"
            },
            "show_in_selector": {
                "description": "Should the rule set be listed in the parser override list (default: false)",
                "type": "boolean"
            },
            "matchkeys": {
                "type": "array",
                "items": {
                    "description": "A set of rules to match individual containers",
                    "type": "object",
                    "anyOf": [
                        {
                            "$ref": "#/$defs/match_rule",
                            "required": [ "pod_name" ]
                        }, {
                            "$ref": "#/$defs/match_rule",
                            "required": [ "container_name" ]
                        }, {
                            "$ref": "#/$defs/match_rule",
                            "required": [ "image_name" ]
                        }, {
                            "$ref": "#/$defs/match_rule",
                            "required": [ "image_regex" ]
                        }
                    ]
                },
                "minItems": 1
            },
            "parser_rules": {
                "description": "An order set of rules to execute when parsing a log",
                "type": "array",
                "items": {
                    "description": "A rule to execute when parsing a log",
                    "anyOf": [
                        {
                            "description": "Parser rules that take no additional options",
                            "type": "object",
                            "properties": {
                                "name": {
                                    "enum": [
                                        "directory",
                                        "expand_event",
                                        "glog",
                                        "iptables",
                                        "modinfo",
                                        "python_traceback",
                                        "seconds_severity_facility",
                                        "strip_ansicodes",
                                        "sysctl",
                                        "ts_8601"
                                    ]
                                }
                            },
                            "requiredProperties": [ "name" ],
                            "additionalProperties": false
                        }, {
                            "type": "object",
                            "properties": {
                                "name": {
                                    "enum": [
                                        "bracketed_severity"
                                    ]
                                },
                                "options": {
                                    "type": "object",
                                    "properties": {
                                        "severity": {
                                            "type": "object",
                                            "properties": {
                                                "default": {
                                                    "$ref": "#/$defs/loglevel"
                                                }
                                            },
                                            "additionalProperties": false
                                        }
                                    },
                                    "additionalProperties": false
                                }
                            },
                            "requiredProperties": [ "name" ],
                            "additionalProperties": false
                        }, {
                            "type": "object",
                            "properties": {
                                "name": {
                                    "enum": [
                                        "custom_splitter"
                                    ]
                                },
                                "options": {
                                    "type": "object",
                                    "properties": {
                                        "regex": {
                                            "description": "The regex pattern to use for matches",
                                            "type": "string"
                                        },
                                        "severity": {
                                            "type": "object",
                                            "properties": {
                                                "field": {
                                                    "description": "The regex capture group to get the severity from, indexed from 1",
                                                    "type": "integer",
                                                    "minimum": 1
                                                },
                                                "overrides": {
                                                    "$ref": "#/$defs/severity_overrides"
                                                },
                                                "transform": {
                                                    "description": "The transformation to use when converting the severity",
                                                    "enum": [
                                                        "3letter",
                                                        "4letter",
                                                        "int",
                                                        "letter",
                                                        "str"
                                                    ]
                                                }
                                            },
                                            "required": [ "field", "transform" ],
                                            "additionalProperties": false
                                        },
                                        "facility": {
                                            "type": "object",
                                            "properties": {
                                                "fields": {
                                                    "description": "The regex capture group(s) to get the facility from, indexed from 1",
                                                    "type": "array",
                                                    "items": {
                                                        "type": "integer",
                                                        "minimum": 1
                                                    }
                                                },
                                                "separators": {
                                                    "description": "The separators to insert between the facility fields. Extra separators will be ignored, the last separator will be reused if len(fields) - 1 > len(separators)",
                                                    "type": "array",
                                                    "items": {
                                                        "description": "A string to insert as separator between two facility fields",
                                                        "type": "string"
                                                    },
                                                    "minItems": 1
                                                }
                                            },
                                            "required": [ "fields" ],
                                            "additionalProperties": false
                                        },
                                        "message": {
                                            "type": "object",
                                            "properties": {
                                                "field": {
                                                    "description": "The regex capture group to get the message from, indexed from 1",
                                                    "type": "integer",
                                                    "minimum": 1
                                                }
                                            },
                                            "required": [ "field" ],
                                            "additionalProperties": false
                                        }
                                    },
                                    "required": [ "regex", "message" ],
                                    "additionalProperties": false
                                }
                            },
                            "required": [ "name", "options" ],
                            "additionalProperties": false
                        }, {
                            "type": "object",
                            "properties": {
                                "name": {
                                    "enum": [
                                        "ansible_line"
                                    ]
                                }
                            },
                            "requiredProperties": [ "name" ],
                            "additionalProperties": false
                        }, {
                            "type": "object",
                            "properties": {
                                "name": {
                                    "enum": [
                                        "diff_line"
                                    ]
                                },
                                "options": {
                                    "type": "object",
                                    "properties": {
                                        "block_start": {
                                            "type": "array",
                                            "items": {
                                                "type": "object",
                                                "properties": {
                                                    "matchtype": {
                                                        "enum": [
                                                            "contains",
                                                            "endswith",
                                                            "exact",
                                                            "regex",
                                                            "startswith"
                                                        ]
                                                    },
                                                    "matchkey": {
                                                        "type": "string"
                                                    },
                                                    "matchline": {
                                                        "enum": [
                                                            "any",
                                                            "first"
                                                        ]
                                                    },
                                                    "format_block_start": {
                                                        "type": "boolean"
                                                    }
                                                },
                                                "additionalProperties": false
                                            },
                                            "minItems": 1
                                        },
                                        "block_end": {
                                            "type": "array",
                                            "items": {
                                                "type": "object",
                                                "properties": {
                                                    "matchtype": {
                                                        "enum": [
                                                            "contains",
                                                            "empty",
                                                            "endswith",
                                                            "exact",
                                                            "regex",
                                                            "startswith"
                                                        ]
                                                    },
                                                    "matchkey": {
                                                        "type": "string"
                                                    },
                                                    "format_block_end": {
                                                        "type": "boolean"
                                                    },
                                                    "process_block_end": {
                                                        "type": "boolean"
                                                    }
                                                },
                                                "additionalProperties": false
                                            },
                                            "minItems": 1
                                        },
                                        "diffspace": {
                                            "description": "Spaces between diff signs and data",
                                            "type": "string"
                                        },
                                        "indent": {
                                            "description": "Indentation before diff",
                                            "type": "string"
                                        },
                                        "severity": {

                                            "type": "object",
                                            "properties": {
                                                "default": {
                                                    "$ref": "#/$defs/loglevel"
                                                },
                                                "overrides": {
                                                    "$ref": "#/$defs/severity_overrides"
                                                }
                                            },
                                            "additionalProperties": false
                                        }
                                    },
                                    "additionalProperties": false
                                }
                            },
                            "requiredProperties": [ "name", "block_start", "block_end" ],
                            "additionalProperties": false
                        }, {
                            "type": "object",
                            "properties": {
                                "name": {
                                    "enum": [
                                        "http"
                                    ]
                                },
                                "options": {
                                    "type": "object",
                                    "properties": {
                                       "timestamp": {
                                           "description": "Configuration options related to timestmaps",
                                           "type": "object",
                                           "properties": {
                                               "reformat": {
                                                   "description": "Should timestamps be reformatted to ISO-8601?",
                                                   "type": "boolean"
                                               }
                                           },
                                           "additionalProperties": false
                                        }
                                    },
                                    "additionalProperties": false
                                }
                            },
                            "requiredProperties": [ "name" ],
                            "additionalProperties": false
                        }, {
                            "type": "object",
                            "properties": {
                                "name": {
                                    "enum": [
                                        "json",
                                        "json_event",
                                        "json_with_leading_message"
                                    ]
                                },
                                "options": {
                                    "type": "object",
                                    "properties": {
                                        "error": {
                                            "$ref": "#/$defs/error"
                                        },
                                        "facility": {
                                            "$ref": "#/$defs/facility"
                                        },
                                        "message": {
                                            "$ref": "#/$defs/message"
                                        },
                                        "severity": {
                                            "$ref": "#/$defs/severity"
                                        },
                                        "timestamp": {
                                            "$ref": "#/$defs/timestamp"
                                        },
                                        "version": {
                                            "$ref": "#/$defs/version"
                                        }
                                    },
                                    "additionalProperties": false
                                }
                            },
                            "requiredProperties": [ "name" ],
                            "additionalProperties": false
                        }, {
                            "type": "object",
                            "properties": {
                                "name": {
                                    "enum": [
                                        "tab_separated"
                                    ]
                                },
                                "options": {
                                    "type": "object",
                                    "properties": {
                                        "error": {
                                            "$ref": "#/$defs/error"
                                        },
                                        "message": {
                                            "$ref": "#/$defs/message"
                                        },
                                        "version": {
                                            "$ref": "#/$defs/version"
                                        }
                                    },
                                    "additionalProperties": false
                                }
                            },
                            "requiredProperties": [ "name" ],
                            "additionalProperties": false
                        }, {
                            "type": "object",
                            "properties": {
                                "name": {
                                    "enum": [
                                        "key_value",
                                        "key_value_with_leading_message"
                                    ]
                                },
                                "options": {
                                    "type": "object",
                                      "properties": {
                                        "allow_bare_keys": {
                                            "description": "Should keys without value be allowed?",
                                            "enum": [
                                                "",
                                                "all",
                                                "capitalize",
                                                "lowercase",
                                                "uppercase"
                                            ]
                                        },
                                        "newlines": {
                                            "enum": [
                                                "keep",
                                                "strip_trailing"
                                            ]
                                        },
                                        "error": {
                                            "$ref": "#/$defs/error"
                                        },
                                        "facility": {
                                            "$ref": "#/$defs/facility"
                                        },
                                        "message": {
                                            "$ref": "#/$defs/message"
                                        },
                                        "severity": {
                                            "$ref": "#/$defs/severity"
                                        },
                                        "timestamp": {
                                            "$ref": "#/$defs/timestamp"
                                        },
                                        "version": {
                                            "$ref": "#/$defs/version"
                                        }
                                    },
                                    "additionalProperties": false
                                }
                            },
                            "requiredProperties": [ "name" ],
                            "additionalProperties": false
                        }, {
                            "type": "object",
                            "properties": {
                                "name": {
                                    "enum": [
                                        "override_severity"
                                    ]
                                },
                                "options": {
                                    "type": "object",
                                    "properties": {
                                        "severity": {
                                            "type": "object",
                                            "properties": {
                                                "overrides": {
                                                    "$ref": "#/$defs/severity_overrides"
                                                }
                                            },
                                            "required": [ "overrides" ],
                                            "additionalProperties": false
                                        }
                                    },
                                    "required": [ "severity" ],
                                    "additionalProperties": false
                                }
                            },
                            "required": [ "name", "options" ],
                            "additionalProperties": false
                        }, {
                            "type": "object",
                            "properties": {
                                "name": {
                                    "enum": [
                                        "custom_line"
                                    ]
                                },
                                "options": {
                                    "type": "object",
                                    "properties": {
                                        "block_start": {
                                            "type": "array",
                                            "items": {
                                                "type": "object",
                                                "properties": {
                                                    "matchtype": {
                                                        "enum": [
                                                            "contains",
                                                            "endswith",
                                                            "exact",
                                                            "regex",
                                                            "startswith"
                                                        ]
                                                    },
                                                    "matchkey": {
                                                        "type": "string"
                                                    },
                                                    "matchline": {
                                                        "enum": [
                                                            "any",
                                                            "first"
                                                        ]
                                                    },
                                                    "format_block_start": {
                                                        "type": "boolean"
                                                    }
                                                },
                                                "additionalProperties": false
                                            },
                                            "minItems": 1
                                        },
                                        "block_end": {
                                            "type": "array",
                                            "items": {
                                                "type": "object",
                                                "properties": {
                                                    "matchtype": {
                                                        "enum": [
                                                            "contains",
                                                            "empty",
                                                            "endswith",
                                                            "exact",
                                                            "regex",
                                                            "startswith"
                                                        ]
                                                    },
                                                    "matchkey": {
                                                        "type": "string"
                                                    },
                                                    "format_block_end": {
                                                        "type": "boolean"
                                                    },
                                                    "process_block_end": {
                                                        "type": "boolean"
                                                    }
                                                },
                                                "additionalProperties": false
                                            },
                                            "minItems": 1
                                        },
                                        "eof": {
                                            "description": "Should EOF be regarded as a block end?",
                                            "type": "boolean"
                                        },
                                        "formatter": {
                                            "description": "Formatter to use when formatting the block (default: format_none())",
                                            "$ref": "#/$defs/formatter_allowlist"
                                        },
                                        "severity": {
                                            "type": "object",
                                            "properties": {
                                                "default": {
                                                    "$ref": "#/$defs/loglevel"
                                                },
                                                "overrides": {
                                                    "$ref": "#/$defs/severity_overrides"
                                                }
                                            },
                                            "additionalProperties": false
                                        }
                                    },
                                    "additionalProperties": false
                                }
                            },
                            "requiredProperties": [ "name", "block_start", "block_end" ],
                            "additionalProperties": false
                        }, {
                            "type": "object",
                            "properties": {
                                "name": {
                                    "enum": [
                                        "json_line"
                                    ]
                                },
                                "options": {
                                    "type": "object",
                                    "properties": {
                                        "allow_empty_lines": {
                                            "description": "Should empty lines be permitted?",
                                            "type": "boolean"
                                        },
                                        "block_start": {
                                            "type": "array",
                                            "items": {
                                                "type": "object",
                                                "properties": {
                                                    "matchtype": {
                                                        "enum": [
                                                            "contains",
                                                            "endswith",
                                                            "exact",
                                                            "regex",
                                                            "startswith"
                                                        ]
                                                    },
                                                    "matchkey": {
                                                        "type": "string"
                                                    },
                                                    "matchline": {
                                                        "enum": [
                                                            "any",
                                                            "first"
                                                        ]
                                                    },
                                                    "format_block_start": {
                                                        "type": "boolean"
                                                    }
                                                },
                                                "additionalProperties": false
                                            },
                                            "minItems": 1
                                        },
                                        "block_end": {
                                            "type": "array",
                                            "items": {
                                                "type": "object",
                                                "properties": {
                                                    "matchtype": {
                                                        "enum": [
                                                            "contains",
                                                            "empty",
                                                            "endswith",
                                                            "exact",
                                                            "regex",
                                                            "startswith"
                                                        ]
                                                    },
                                                    "matchkey": {
                                                        "type": "string"
                                                    },
                                                    "format_block_end": {
                                                        "type": "boolean"
                                                    },
                                                    "process_block_end": {
                                                        "type": "boolean"
                                                    }
                                                },
                                                "additionalProperties": false
                                            },
                                            "minItems": 1
                                        }
                                    },
                                    "additionalProperties": false
                                }
                            },
                            "requiredProperties": [ "name", "block_start", "block_end" ],
                            "additionalProperties": false
                        }
                    ],
                    "minItems": 1
                },
                "minItems": 1
            }
        },
        "required": [ "name", "matchkeys", "parser_rules" ],
        "additionalProperties": false
    },
    "uniqueItems": true,
    "minItems": 1
}
